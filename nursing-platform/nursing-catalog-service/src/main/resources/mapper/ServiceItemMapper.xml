<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nursing.catalog.repository.ServiceItemMapper">

    <sql id="VisibleItemWhere">
        si.status = 1
        AND si.is_deleted = 0
        AND sc.status = 1
        AND sc.is_deleted = 0
        AND NOT EXISTS (
            SELECT 1
            FROM service_category ancestor
            WHERE (ancestor.status &lt;&gt; 1 OR ancestor.is_deleted &lt;&gt; 0)
              AND sc.path LIKE CONCAT(ancestor.path, '%')
        )
    </sql>

    <sql id="CategoryFilter">
        <if test="categoryIds != null and !categoryIds.isEmpty()">
            AND si.category_id IN
            <foreach collection="categoryIds" item="categoryId" open="(" separator="," close=")">
                #{categoryId}
            </foreach>
        </if>
    </sql>

    <sql id="CursorFilter">
        <if test="cursorSortOrder != null and cursorId != null">
            AND (
                si.sort_order &gt; #{cursorSortOrder}
                OR (si.sort_order = #{cursorSortOrder} AND si.id &gt; #{cursorId})
            )
        </if>
    </sql>

    <sql id="ItemPageColumns">
        si.id AS item_id,
        si.category_id,
        sc.name AS category_name,
        si.name,
        si.description,
        si.cover_image,
        si.sort_order,
        si.status,
        (
            SELECT MIN(ss.price)
            FROM service_spec ss
            WHERE ss.service_item_id = si.id
              AND ss.status = 1
              AND ss.is_deleted = 0
        ) AS min_price
    </sql>

    <resultMap id="ItemPageMap" type="com.nursing.catalog.dto.response.ItemListResponse">
        <id property="itemId" column="item_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="coverImage" column="cover_image"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="minPrice" column="min_price"/>
    </resultMap>

    <resultMap id="ItemDetailMap" type="com.nursing.catalog.dto.response.ItemDetailResponse">
        <id property="itemId" column="item_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="coverImage" column="cover_image"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectPage" resultMap="ItemPageMap">
        SELECT
        <include refid="ItemPageColumns"/>
        FROM service_item si
        INNER JOIN service_category sc ON sc.id = si.category_id
        WHERE <include refid="VisibleItemWhere"/>
        <include refid="CategoryFilter"/>
        <include refid="CursorFilter"/>
        ORDER BY si.sort_order ASC, si.id ASC
        LIMIT #{limit}
    </select>

    <select id="selectById" resultMap="ItemDetailMap">
        SELECT
            si.id AS item_id,
            si.category_id,
            sc.name AS category_name,
            si.name,
            si.description,
            si.cover_image,
            si.sort_order,
            si.status,
            si.create_time
        FROM service_item si
        INNER JOIN service_category sc ON sc.id = si.category_id
        WHERE si.id = #{id}
          AND <include refid="VisibleItemWhere"/>
        LIMIT 1
    </select>

    <select id="searchPage" resultMap="ItemPageMap">
        SELECT
        <include refid="ItemPageColumns"/>
        FROM service_item si
        INNER JOIN service_category sc ON sc.id = si.category_id
        WHERE <include refid="VisibleItemWhere"/>
        <include refid="CategoryFilter"/>
        <include refid="CursorFilter"/>
          AND (si.name LIKE CONCAT('%', #{keyword}, '%')
               OR si.description LIKE CONCAT('%', #{keyword}, '%'))
        ORDER BY si.sort_order ASC, si.id ASC
        LIMIT #{limit}
    </select>
</mapper>
