<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nursing.catalog.repository.ServiceSpecMapper">

    <resultMap id="SpecMap" type="com.nursing.catalog.dto.vo.SpecVO">
        <id property="specId" column="spec_id"/>
        <result property="serviceItemId" column="service_item_id"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
        <result property="originalPrice" column="original_price"/>
        <result property="duration" column="duration"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="selectByItemId" resultMap="SpecMap">
        SELECT
            id AS spec_id,
            service_item_id,
            name,
            price,
            original_price,
            duration,
            status
        FROM service_spec
        WHERE service_item_id = #{serviceItemId}
          AND status = 1
          AND is_deleted = 0
        ORDER BY id ASC
    </select>

    <select id="selectByItemIds" resultMap="SpecMap">
        SELECT
            id AS spec_id,
            service_item_id,
            name,
            price,
            original_price,
            duration,
            status
        FROM service_spec
        WHERE service_item_id IN
        <foreach collection="serviceItemIds" item="serviceItemId" open="(" separator="," close=")">
            #{serviceItemId}
        </foreach>
          AND status = 1
          AND is_deleted = 0
        ORDER BY service_item_id ASC, id ASC
    </select>
</mapper>
