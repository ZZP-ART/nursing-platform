<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nursing.user.mapper.UserTokenMapper">

    <resultMap id="UserTokenResultMap" type="com.nursing.user.entity.UserToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="token" column="token"/>
        <result property="expireTime" column="expire_time"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.nursing.user.entity.UserToken">
        INSERT INTO user_token (
            id, user_id, token, expire_time, is_deleted, create_time
        ) VALUES (
            #{id}, #{userId}, #{token}, #{expireTime}, #{isDeleted}, #{createTime}
        )
    </insert>

    <select id="selectByUserId" resultMap="UserTokenResultMap">
        SELECT id, user_id, token, expire_time, is_deleted, create_time
        FROM user_token
        WHERE user_id = #{userId}
          AND is_deleted = 0
        ORDER BY create_time DESC
    </select>
</mapper>
