<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nursing.order.repository.OrderSequenceMapper">
    <insert id="nextSequence">
        INSERT INTO order_sequence (stub)
        VALUES ('0')
        ON DUPLICATE KEY UPDATE id = LAST_INSERT_ID(id + 1)
    </insert>

    <select id="lastInsertId" resultType="long">
        SELECT LAST_INSERT_ID()
    </select>
</mapper>
